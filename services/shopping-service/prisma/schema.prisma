generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

// Audit trail of admin actions on orders. Append-only; one row per action.
model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int      // admin user id (from JWT)
  actorEmail String
  action     String   // e.g. UPDATE_STATUS
  entity     String   @default("ORDER")
  entityId   Int?     // order id the action targeted
  details    Json?    // before-after snapshot
  createdAt  DateTime @default(now())

  @@index([entityId])
  @@index([actorId])
  @@map("audit_logs")
}

// One cart per user. userId references the user-service (no FK across services).
model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int      // references product-service
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  id        Int         @id @default(autoincrement())
  userId    Int         // references user-service
  status    OrderStatus @default(PENDING)
  total     Decimal     @db.Decimal(10, 2)
  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
  @@map("orders")
}

// ---------------------------------------------------------------------------
// Event-driven read model + infrastructure (no broker)
// ---------------------------------------------------------------------------

// Local copy of product-service catalogue data, kept fresh by consuming
// product.* events. A CQRS read model: analytics reads from here instead of
// making a synchronous cross-service call on every request.
model ProductProjection {
  id        Int      @id // mirrors product-service product id (no autoincrement)
  name      String
  price     Decimal  @db.Decimal(10, 2)
  stock     Int      @default(0)
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("product_projection")
}

// Domain events written in the SAME transaction as the business change, then
// delivered to subscribers by the background relay. At-least-once delivery.
model OutboxEvent {
  id          Int       @id @default(autoincrement())
  eventId     String    @unique // idempotency key carried to consumers
  type        String // e.g. "order.placed"
  payload     Json
  status      String    @default("PENDING") // PENDING | PUBLISHED | FAILED
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  @@index([status])
  @@map("outbox_events")
}

// Records every event this service has processed so re-deliveries are no-ops.
model InboxEvent {
  eventId    String   @id
  type       String
  receivedAt DateTime @default(now())

  @@map("inbox_events")
}

// Order items snapshot product data at purchase time.
model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int     // references product-service
  productName String
  price       Decimal @db.Decimal(10, 2)
  quantity    Int

  @@map("order_items")
}
