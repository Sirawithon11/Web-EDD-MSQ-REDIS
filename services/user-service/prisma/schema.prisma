generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(USER)
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- event-driven projection ---
  // Kept up to date by consuming order.* events from shopping-service.
  ordersCount Int       @default(0)
  totalSpent  Decimal   @default(0) @db.Decimal(12, 2)
  lastOrderAt DateTime?

  @@map("users")
}

// ---------------------------------------------------------------------------
// Event-driven design now runs over RabbitMQ (pure broker) — see src/events/.
// user-service publishes user.registered and consumes order.* to maintain the
// per-user projection above. No outbox/inbox tables required.
// ---------------------------------------------------------------------------
