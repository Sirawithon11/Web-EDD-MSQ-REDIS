generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())

  @@map("categories")
}

// Audit trail of admin actions on products. Append-only; one row per action.
model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int      // admin user id (from JWT)
  actorEmail String
  action     String   // CREATE | UPDATE | DELETE
  entity     String   @default("PRODUCT")
  entityId   Int?     // product id the action targeted
  details    Json?    // payload / before-after snapshot
  createdAt  DateTime @default(now())

  @@index([entityId])
  @@index([actorId])
  @@map("audit_logs")
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  imageUrl    String?
  sku         String   @unique
  active      Boolean  @default(true)
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Cumulative units sold, maintained by consuming order.* events. This is a
  // popularity counter and is independent of `stock` (still set by the saga).
  salesCount  Int      @default(0)

  @@index([categoryId])
  @@map("products")
}

// ---------------------------------------------------------------------------
// Event-driven design now runs over RabbitMQ (pure broker) — see src/events/.
// Producers publish to the domain.events topic exchange after the DB commit;
// consumers read from their own durable queue. No outbox/inbox tables required.
// ---------------------------------------------------------------------------
